{
  "name": "ipod-player",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "iPod Click Wheel 音乐播放器 - Web + Capacitor iOS 自用版",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "cap:sync": "cap sync",
    "cap:add:ios": "cap add ios",
    "cap:open:ios": "cap open ios",
    "ios:build": "npm run build && cap sync ios"
  },
  "dependencies": {
    "@capacitor-community/screen-brightness": "^6.0.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.1.2",
    "@capacitor/haptics": "^6.0.1",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/status-bar": "^6.0.1",
    "capacitor-volume-controller": "^2.1.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
